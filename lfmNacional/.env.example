# ============================================
# LFM Nacional - Variables de Entorno
# ============================================
# Copiar a .env y completar los valores.
# Ejemplo de referencia: web service Render + MySQL Aiven + front Vercel.

# ---- Base de datos (Aiven MySQL free) ----
DB_USERNAME=avnadmin
DB_PASSWORD=cambiar-est-password
# SSL obligatorio en Aiven (puerto no-3306):
DB_URL=jdbc:mysql://HOST.aivencloud.com:PUERTO/defaultdb?serverTimezone=UTC&useSSL=true&ssl-mode=REQUIRED&allowPublicKeyRetrieval=true&enabledTLSProtocols=TLSv1.2

# ---- JPA ----
# update: Hibernate crea/ajusta el schema (default en prod, sin Flyway).
# validate / none: válidos solo si el schema ya existe.
JPA_DDL_AUTO=update

# ---- JWT ----
# Generar con: openssl rand -base64 64
JWT_SECRETO=cambiar-est-secretolargo-para-firmar-tokens

# ---- Frontend / URLs ----
# URL pública del frontend (Vercel). Sin trailing slash.
FRONTEND_URL=https://lfmn.vercel.app

# ---- API (web service en Render; en el contenedor escucha en $PORT) ----
# Render inyecta PORT automáticamente; la app escucha ahí. No setear SERVER_PORT.
SERVER_PORT=8080

# ---- CORS ----
# Origen(es) del frontend (separados por coma para varios).
CORS_ALLOWED_ORIGINS=https://lfmn.vercel.app

# ---- Steam OpenID ----
# Apuntan a la API (Render), NO al frontend. Si se omiten se usa FRONTEND_URL.
STEAM_REALM=https://lfmn.onrender.com
STEAM_RETURN_TO=https://lfmn.onrender.com/api/steam/vinculacion/callback
STEAM_RETURN_TO_AUTH=https://lfmn.onrender.com/api/steam/auth/callback

# ---- Rutas (contenedor Render: disco efímero) ----
SESIONES_DIR=/app/sesiones
ARCHIVOS_DIR=/app/archivos

# ---- SMTP (opcional: Gmail con app password) ----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=