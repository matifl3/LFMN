# ============================================
# LFM Nacional - Variables de Entorno
# ============================================
# Copiar a .env y completar los valores

# ---- Base de datos ----
DB_USERNAME=lfm_user
DB_PASSWORD=cambiar-est-password

# ---- JWT ----
# Generar con: openssl rand -base64 64
JWT_SECRETO=cambiar-est-secretolargo-para-firmar-tokens

# ---- Frontend / URLs ----
# URL pública del servidor (sin trailing slash)
FRONTEND_URL=http://localhost:8080

# ---- CORS ----
# Dominios permitidos (separados por coma para múltiples)
CORS_ALLOWED_ORIGINS=http://localhost:8080

# ---- Servidor ----
SERVER_PORT=8080

# ---- Rutas (opcional, solo si necesitas cambiar defaults) ----
# SESIONES_DIR=/home/ubuntu/app/sesiones
# ARCHIVOS_DIR=/home/ubuntu/app/archivos
