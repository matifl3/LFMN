[Unit]
Description=Importador de sesiones Assetto Corsa -> LFM Nacional API
Documentation=file:///home/ubuntu/app/scripts/importar-sesion.sh
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/app
ExecStart=/bin/bash /home/ubuntu/app/scripts/importar-sesion.sh
Restart=always
RestartSec=10
StandardOutput=append:/home/ubuntu/app/logs/importar-sesion.log
StandardError=append:/home/ubuntu/app/logs/importar-sesion.log

# TOKEN_COMISARIO, SESION_DIR, CARRERA_ID, API_URL
EnvironmentFile=-/home/ubuntu/app/.env
Environment=SESION_DIR=/home/ubuntu/app/sesiones
Environment=API_URL=https://lfmn.onrender.com

[Install]
WantedBy=multi-user.target